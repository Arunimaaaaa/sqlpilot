# API Environment Variables
PORT=4000
NODE_ENV=development
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars

# Metadata Store (SQLPilot's own DB)
METADATA_DB_SERVER=localhost
METADATA_DB_PORT=1433
METADATA_DB_NAME=SQLPilotMeta
METADATA_DB_USER=sa
METADATA_DB_PASSWORD=SqlPilotStrongP@ss2026!
METADATA_DB_ENCRYPT=false
METADATA_DB_TRUST_SERVER_CERT=true

# Local Dev Fallback (if real SQL Server container is offline, enables seamless dev)
USE_IN_MEMORY_FALLBACK_IF_SQLSERVER_UNREACHABLE=true

# Secrets Manager Config (local stub vs AWS)
SECRETS_STORAGE_TYPE=local_vault # local_vault | aws_secrets_manager
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
LOCAL_VAULT_ENCRYPTION_KEY=32_bytes_super_secret_encryption_key_here!

# LLM Provider Configuration
LLM_PROVIDER=gemini # gemini | openai | bedrock | mock
GEMINI_API_KEY=
OPENAI_API_KEY=
BEDROCK_REGION=us-east-1
LLM_MODEL=gemini-2.5-flash

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
